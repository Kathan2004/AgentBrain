{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentBrain Checkpoint",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkpointId",
    "taskId",
    "timestamp",
    "status",
    "agent",
    "git",
    "progress",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "checkpointId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "checkpoint",
        "handoff",
        "review",
        "blocked",
        "failed",
        "done"
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        }
      }
    },
    "git": {
      "type": "object",
      "required": [
        "head",
        "branch",
        "dirty",
        "changedFiles"
      ],
      "properties": {
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "completed",
        "remaining"
      ],
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remaining": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextAction": {
      "type": "string"
    },
    "stopReason": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
